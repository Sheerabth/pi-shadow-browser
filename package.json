{
  "name": "pi-shadow-browser",
  "version": "0.1.0",
  "description": "Pi extension: Pi browses websites through its own stealth browser. Search, open, navigate, act.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "pi-shadow-browser": "./dist/examples/run.js"
  },
  "scripts": {
    "build": "tsc && cp -r vendor dist/vendor",
    "typecheck": "tsc --noEmit",
    "run": "tsx examples/run.ts",
    "run:simple": "tsx examples/run_simple.ts",
    "postinstall": "camoufox-js fetch || true"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ecosystem/pi-shadow-browser.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser",
    "automation",
    "camoufox"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "src",
    "vendor",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "camoufox-js": "^0.13.0",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
